rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validStoreId(id) {
      return id in ['1', '2', '3'] || exists(/databases/$(database)/documents/stores/$(id));
    }
    match /stores/{storeId} {
      allow read: if true;
      allow create: if !(storeId in ['1', '2', '3'])
        && request.resource.data.keys().hasOnly(['name', 'brand', 'summary', 'address', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.brand is string && request.resource.data.brand.size() > 0 && request.resource.data.brand.size() <= 100
        && request.resource.data.address is string && request.resource.data.address.size() <= 200
        && request.resource.data.summary == 'まだ口コミがありません。'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /reviews/{reviewId} {
      function legacyReview(d) {
        return !('type' in d)
          && d.keys().hasOnly(['storeId', 'score', 'comment', 'createdAt'])
          && d.score is int && d.score >= 0 && d.score <= 10
          && d.comment is string && d.comment.size() <= 2000;
      }
      function validWorkYear(d) {
        let year = (request.time + duration.value(9, 'h')).year();
        return (d.currentlyWorking == true && d.lastWorkedYear == null)
          || (d.currentlyWorking == false && d.lastWorkedYear is int
            && d.lastWorkedYear >= year - 9 && d.lastWorkedYear <= year);
      }
      function rating(d) {
        return d.type == 'rating'
          && d.keys().hasOnly(['storeId', 'type', 'currentlyWorking', 'lastWorkedYear', 'score', 'createdAt'])
          && d.score is int && d.score >= 0 && d.score <= 10;
      }
      function wage(d) {
        return d.type == 'wage'
          && d.keys().hasOnly(['storeId', 'type', 'currentlyWorking', 'lastWorkedYear', 'hourlyWage', 'createdAt'])
          && d.hourlyWage is int && d.hourlyWage >= 1 && d.hourlyWage <= 100000;
      }
      function period(d) {
        return d.type == 'period'
          && d.keys().hasOnly(['storeId', 'type', 'currentlyWorking', 'lastWorkedYear', 'workPeriod', 'createdAt'])
          && d.workPeriod in ['3か月未満', '3か月〜半年', '半年〜1年', '1年以上'];
      }
      function comment(d) {
        return d.type == 'comment'
          && d.keys().hasOnly(['storeId', 'type', 'currentlyWorking', 'lastWorkedYear', 'comment', 'createdAt'])
          && d.comment is string && d.comment.matches('[\\s\\S]*[^\\s][\\s\\S]*') && d.comment.size() <= 2000;
      }
      allow read: if true;
      allow create: if request.resource.data.storeId is string
        && validStoreId(request.resource.data.storeId)
        && request.resource.data.createdAt == request.time
        && (legacyReview(request.resource.data)
          || ('type' in request.resource.data && validWorkYear(request.resource.data) && (rating(request.resource.data)
            || wage(request.resource.data) || period(request.resource.data) || comment(request.resource.data))));
      allow update, delete: if false;
    }
  }
}
